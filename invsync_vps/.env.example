# Copy this template to .env and fill in real values locally.
# Do not commit .env, server addresses, credentials, usernames or private paths.
INVSYNC_API_TOKEN=replace-me
INVSYNC_DATA_DIR=./data
INVSYNC_BIND_HOST=127.0.0.1
PORT=3000

# BedrockBridge-compatible player name map header (set your own UUID).
INVSYNC_DEFAULT_HEADER_UUID=

# SSH-backed world DB sources for centralized VPS mode.
# Use a dedicated, least-privileged SSH account and a local private key.
INVSYNC_WORLD_SOURCE_RESOURCE_TYPE=ssh
INVSYNC_WORLD_SOURCE_RESOURCE_DB_PATH=/srv/minecraft/resource/worlds/example-world/db
INVSYNC_WORLD_SOURCE_RESOURCE_HEADER_UUID=
INVSYNC_WORLD_SOURCE_RESOURCE_SSH_HOST=ssh.example.com
INVSYNC_WORLD_SOURCE_RESOURCE_SSH_PORT=22
INVSYNC_WORLD_SOURCE_RESOURCE_SSH_USER=invsync-reader
INVSYNC_WORLD_SOURCE_RESOURCE_SSH_KEY_PATH=/home/invsync/.ssh/id_ed25519

INVSYNC_WORLD_SOURCE_SURVIVAL_TYPE=ssh
INVSYNC_WORLD_SOURCE_SURVIVAL_DB_PATH=/srv/minecraft/survival/worlds/example-world/db
INVSYNC_WORLD_SOURCE_SURVIVAL_HEADER_UUID=
INVSYNC_WORLD_SOURCE_SURVIVAL_SSH_HOST=ssh.example.com
INVSYNC_WORLD_SOURCE_SURVIVAL_SSH_PORT=22
INVSYNC_WORLD_SOURCE_SURVIVAL_SSH_USER=invsync-reader
INVSYNC_WORLD_SOURCE_SURVIVAL_SSH_KEY_PATH=/home/invsync/.ssh/id_ed25519

# FTP-backed source: prefer SFTP/SSH if possible. If using FTP, require FTPS.
# FTP_SECURE=true is explicit FTPS TLS, not SFTP. Configure the server accordingly.
INVSYNC_WORLD_SOURCE_CIRCUIT_TYPE=ftp
INVSYNC_WORLD_SOURCE_CIRCUIT_DB_PATH=/minecraft/worlds/example-world/db
INVSYNC_WORLD_SOURCE_CIRCUIT_HEADER_UUID=
INVSYNC_WORLD_SOURCE_CIRCUIT_FTP_HOST=ftp.example.com
INVSYNC_WORLD_SOURCE_CIRCUIT_FTP_PORT=21
INVSYNC_WORLD_SOURCE_CIRCUIT_FTP_USER=example-user
INVSYNC_WORLD_SOURCE_CIRCUIT_FTP_PASSWORD=replace-me
INVSYNC_WORLD_SOURCE_CIRCUIT_FTP_SECURE=true
